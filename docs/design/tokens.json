      { "fg": "--fg-dim", "bg": "--sidebar-bg", "min": 4.5, "light": 4.54, "dark": 5.24 },
      { "fg": "--fg-dim", "bg": "--popover-bg", "min": 4.5, "light": 4.74, "dark": 4.87 },
      { "fg": "--accent", "bg": "--view-bg", "min": 4.5, "light": 6.07, "dark": 9.93 },
      { "fg": "--accent", "bg": "--sidebar-bg", "min": 4.5, "light": 5.10, "dark": 7.98 },
      { "fg": "--accent-fg", "bg": "--suggested-bg", "min": 4.5, "light": 4.77, "dark": 4.77 },
      { "fg": "#ffffff", "bg": "--destructive-bg", "min": 4.5, "light": 4.83, "dark": 6.11 },
