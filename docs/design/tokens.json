      "editor": { "$type": "typography", "$value": { "fontSize": "calc(14px * var(--text-zoom, 1))", "lineHeight": 1.75, "fontFamily": "{font.family.mono}" }, "$extensions": { "inkwell": { "css": "--text-editor", "today": "frontend/src/editor/setup.ts:32" } } }
    }
  },
  "space": {
