    "preview": { "$type": "dimension", "$value": "50%", "$extensions": { "inkwell": { "min": "260px", "max": "70%" } } },
    "source-min": { "$type": "dimension", "$value": "280px" },
    "window-min": { "$type": "dimension", "$value": "360px × 480px" },
    "breakpoint": {
      "wide": { "$type": "dimension", "$value": "1200px" },
      "medium": { "$type": "dimension", "$value": "900px" },
      "narrow": { "$type": "dimension", "$value": "560px" }
