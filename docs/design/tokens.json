{
  "$description": "Jetons de design d'Inkwell (N17, révision 1, 2026-11-01). Référence lisible par machine de docs/design/spec.md §2. Le code consomme frontend/src/theme/tokens.css ; frontend/src/theme/tokens.test.ts vérifie que chaque jeton ci-dessous y existe avec la même valeur (clé `css`, valeurs `$value` = clair, `dark` = sombre, `hc` = contraste élevé) et que chaque paire de `contrast` atteint son seuil. Format inspiré du Design Tokens Community Group ($value, $type, $description) ; les couleurs sont des chaînes CSS. `status` : `kept` = inchangé, `changed` = valeur corrigée par N17, `new` = à ajouter à tokens.css.",
  "$extensions": {
    "inkwell": {
      "source": "frontend/src/theme/tokens.css",
      "modes": ["light", "dark", "hc"],
      "base": "libadwaita 1.8 css-variables"
    }
  },
  "color": {
    "surface": {
      "window-bg": { "$type": "color", "$value": "#fafafb", "$extensions": { "inkwell": { "css": "--window-bg", "dark": "#222226", "status": "kept" } } },
      "view-bg": { "$type": "color", "$value": "#ffffff", "$extensions": { "inkwell": { "css": "--view-bg", "dark": "#1d1d20", "status": "kept" } } },
      "headerbar-bg": { "$type": "color", "$value": "#ffffff", "$extensions": { "inkwell": { "css": "--headerbar-bg", "dark": "#2e2e32", "status": "kept" } } },
      "sidebar-bg": { "$type": "color", "$value": "#ebebed", "$extensions": { "inkwell": { "css": "--sidebar-bg", "dark": "#2e2e32", "status": "kept" } } },
      "side-bg-2": { "$type": "color", "$value": "#f3f3f5", "$extensions": { "inkwell": { "css": "--side-bg-2", "dark": "#28282c", "status": "kept" } } },
      "card-bg": { "$type": "color", "$value": "#ffffff", "$extensions": { "inkwell": { "css": "--card-bg", "dark": "rgb(255 255 255 / 8%)", "status": "kept" } } },
      "popover-bg": { "$type": "color", "$value": "#ffffff", "$extensions": { "inkwell": { "css": "--popover-bg", "dark": "#36363a", "status": "kept" } } },
      "dialog-bg": { "$type": "color", "$value": "#fafafb", "$extensions": { "inkwell": { "css": "--dialog-bg", "dark": "#36363a", "status": "new" } } },
      "toast-bg": { "$type": "color", "$value": "rgb(0 0 6 / 84%)", "$extensions": { "inkwell": { "css": "--toast-bg", "dark": "#36363a", "status": "new" } } },
      "tooltip-bg": { "$type": "color", "$value": "rgb(0 0 6 / 80%)", "$extensions": { "inkwell": { "css": "--tooltip-bg", "dark": "rgb(0 0 6 / 80%)", "status": "kept" } } },
      "stage-bg": { "$type": "color", "$value": "#000000", "$extensions": { "inkwell": { "css": "--stage-bg", "dark": "#000000", "status": "new" } } },
      "stage-overlay": { "$type": "color", "$value": "rgb(0 0 0 / 55%)", "$extensions": { "inkwell": { "css": "--stage-overlay", "dark": "rgb(0 0 0 / 55%)", "status": "new" } } },
      "page-bg": { "$type": "color", "$value": "#ffffff", "$extensions": { "inkwell": { "css": "--page-bg", "dark": "#ffffff", "status": "new" } } },
      "backdrop": { "$type": "color", "$value": "rgb(0 0 6 / 30%)", "$extensions": { "inkwell": { "css": "--backdrop", "dark": "rgb(0 0 0 / 45%)", "status": "new" } } }
    },
    "text": {
      "fg": { "$type": "color", "$value": "rgb(0 0 6 / 80%)", "$extensions": { "inkwell": { "css": "--fg", "dark": "#ffffff", "status": "kept" } } },
      "fg-dim": { "$type": "color", "$value": "rgb(0 0 6 / 55%)", "$extensions": { "inkwell": { "css": "--fg-dim", "dark": "rgb(255 255 255 / 55%)", "hc": "rgb(0 0 6 / 90%) | rgb(255 255 255 / 90%)", "status": "changed", "was": "hc 75% / 80%" } } },
      "accent": { "$type": "color", "$value": "#0461be", "$description": "Texte et liens en couleur d'accent.", "$extensions": { "inkwell": { "css": "--accent", "dark": "#81d0ff", "status": "kept" } } },
      "accent-fg": { "$type": "color", "$value": "#ffffff", "$extensions": { "inkwell": { "css": "--accent-fg", "dark": "#ffffff", "status": "kept" } } },
      "tooltip-fg": { "$type": "color", "$value": "#ffffff", "$extensions": { "inkwell": { "css": "--tooltip-fg", "dark": "#ffffff", "status": "kept" } } }
    },
    "line": {
      "border": { "$type": "color", "$value": "rgb(0 0 6 / 15%)", "$extensions": { "inkwell": { "css": "--border", "dark": "rgb(255 255 255 / 15%)", "hc": "rgb(0 0 6 / 50%) | rgb(255 255 255 / 50%)", "status": "changed", "was": "12% ; hc 45%" } } },
      "shade": { "$type": "color", "$value": "rgb(0 0 6 / 12%)", "$extensions": { "inkwell": { "css": "--shade", "dark": "rgb(0 0 6 / 36%)", "status": "kept" } } },
      "card-shade": { "$type": "color", "$value": "rgb(0 0 6 / 7%)", "$extensions": { "inkwell": { "css": "--card-shade", "dark": "rgb(0 0 6 / 36%)", "status": "kept" } } }
    },
    "interaction": {
      "btn-bg": { "$type": "color", "$value": "rgb(0 0 6 / 10%)", "$extensions": { "inkwell": { "css": "--btn-bg", "dark": "rgb(255 255 255 / 10%)", "status": "kept" } } },
      "hover-bg": { "$type": "color", "$value": "rgb(0 0 6 / 7%)", "$extensions": { "inkwell": { "css": "--hover-bg", "dark": "rgb(255 255 255 / 7%)", "status": "kept" } } },
      "selected-bg": { "$type": "color", "$value": "rgb(0 0 6 / 10%)", "$extensions": { "inkwell": { "css": "--selected-bg", "dark": "rgb(255 255 255 / 10%)", "status": "kept" } } },
      "accent-bg": { "$type": "color", "$value": "#3584e4", "$description": "Remplissage seulement ; jamais de texte blanc dessus (3,77:1).", "$extensions": { "inkwell": { "css": "--accent-bg", "dark": "#3584e4", "status": "kept" } } },
      "suggested-bg": { "$type": "color", "$value": "#1c71d8", "$extensions": { "inkwell": { "css": "--suggested-bg", "dark": "#1c71d8", "status": "kept" } } },
      "destructive-bg": { "$type": "color", "$value": "#e01b24", "$extensions": { "inkwell": { "css": "--destructive-bg", "dark": "#c01c28", "status": "new" } } },
      "focus-ring": { "$type": "border", "$value": "2px solid var(--accent)", "$description": "Écart assumé avec libadwaita (anneau translucide) : 1.4.11 exige 3:1.", "$extensions": { "inkwell": { "css": "--focus-ring", "status": "changed", "was": "2px solid color-mix(in srgb, var(--accent-bg) 75%, transparent)", "offset": "2px" } } },
      "disabled-opacity": { "$type": "number", "$value": 0.5, "$extensions": { "inkwell": { "css": "--disabled-opacity", "status": "new", "was": "0.45 et 0.5 mélangés" } } }
    },
    "state": {
      "success": { "$type": "color", "$value": "#007c3d", "$extensions": { "inkwell": { "css": "--success", "dark": "#78e9ab", "status": "changed", "was": "#2ec27e (2,30:1 sur blanc)" } } },
      "success-bg": { "$type": "color", "$value": "#2ec27e", "$extensions": { "inkwell": { "css": "--success-bg", "dark": "#26a269", "status": "new" } } },
      "warning": { "$type": "color", "$value": "#905400", "$extensions": { "inkwell": { "css": "--warning", "dark": "#ffc252", "status": "kept" } } },
      "warning-bg": { "$type": "color", "$value": "#fdf3e1", "$extensions": { "inkwell": { "css": "--warning-bg", "dark": "rgb(255 194 82 / 14%)", "status": "kept" } } },
      "error": { "$type": "color", "$value": "#c30000", "$extensions": { "inkwell": { "css": "--error", "dark": "#ff938c", "status": "changed", "was": "#c01c28 / #ff7b63" } } },
      "error-bg": { "$type": "color", "$value": "#fce8e9", "$extensions": { "inkwell": { "css": "--error-bg", "dark": "rgb(255 147 140 / 14%)", "status": "changed", "was": "dark rgb(255 123 99 / 14%)" } } },
      "destructive": { "$type": "color", "$value": "{color.state.error}", "$extensions": { "inkwell": { "css": "--destructive", "status": "changed" } } },
      "info-bg": { "$type": "color", "$value": "#e3eefb", "$extensions": { "inkwell": { "css": "--info-bg", "dark": "#2b4b73", "status": "kept" } } }
    },
    "diff": {
      "add-bg": { "$type": "color", "$value": "#d4f0df", "$extensions": { "inkwell": { "css": "--diff-add-bg", "dark": "rgb(87 227 137 / 22%)", "status": "kept" } } },
      "add-fg": { "$type": "color", "$value": "#0b4a2a", "$extensions": { "inkwell": { "css": "--diff-add-fg", "dark": "#c6f7d9", "status": "kept" } } },
      "del-bg": { "$type": "color", "$value": "#fbd9d9", "$extensions": { "inkwell": { "css": "--diff-del-bg", "dark": "rgb(255 123 99 / 24%)", "status": "kept" } } },
      "del-fg": { "$type": "color", "$value": "#7a0f18", "$extensions": { "inkwell": { "css": "--diff-del-fg", "dark": "#ffd0c7", "status": "kept" } } }
    },
    "syntax": {
      "$description": "Inchangés ; vérifiés à 4,5:1 par tokens.test.ts.",
      "heading": { "$type": "color", "$value": "#1c71d8", "$extensions": { "inkwell": { "css": "--hl-heading", "dark": "#78aeed" } } },
      "function": { "$type": "color", "$value": "#c64600", "$extensions": { "inkwell": { "css": "--hl-function", "dark": "#ffa348" } } },
      "string": { "$type": "color", "$value": "#1a7a4c", "$extensions": { "inkwell": { "css": "--hl-string", "dark": "#57e389" } } },
      "label": { "$type": "color", "$value": "#9141ac", "$extensions": { "inkwell": { "css": "--hl-label", "dark": "#dc8add" } } },
      "comment": { "$type": "color", "$value": "#6f6e74", "$extensions": { "inkwell": { "css": "--hl-comment", "dark": "#9a9996" } } },
      "keyword": { "$type": "color", "$value": "#c01c28", "$extensions": { "inkwell": { "css": "--hl-keyword", "dark": "#ff7b63" } } },
      "number": { "$type": "color", "$value": "#8f5902", "$extensions": { "inkwell": { "css": "--hl-number", "dark": "#f8e45c" } } },
      "raw": { "$type": "color", "$value": "#5e5c64", "$extensions": { "inkwell": { "css": "--hl-raw", "dark": "#c0bfbc" } } },
      "marker": { "$type": "color", "$value": "#1c71d8", "$extensions": { "inkwell": { "css": "--hl-marker", "dark": "#78aeed" } } }
    },
    "file-mark": {
      "typst": { "$type": "color", "$value": "#1a8f9e", "$extensions": { "inkwell": { "css": "--mark-typst", "dark": "#4fd0e0", "status": "kept" } } },
      "markdown": { "$type": "color", "$value": "#1c71d8", "$extensions": { "inkwell": { "css": "--mark-markdown", "dark": "#78aeed", "status": "changed", "was": "#3584e4" } } },
      "csv": { "$type": "color", "$value": "#1b8553", "$extensions": { "inkwell": { "css": "--mark-csv", "dark": "#57e389", "status": "changed", "was": "#26a269 (2,73:1)" } } },
      "bib": { "$type": "color", "$value": "#9141ac", "$extensions": { "inkwell": { "css": "--mark-bib", "dark": "#dc8add", "status": "kept" } } },
      "image": { "$type": "color", "$value": "#c64600", "$extensions": { "inkwell": { "css": "--mark-image", "dark": "#ffa348", "status": "changed", "was": "#e66100 (2,90:1)" } } },
      "pdf": { "$type": "color", "$value": "#e01b24", "$extensions": { "inkwell": { "css": "--mark-pdf", "dark": "#f66151", "status": "kept" } } },
      "data": { "$type": "color", "$value": "#a2680c", "$extensions": { "inkwell": { "css": "--mark-data", "dark": "#f8e45c", "status": "kept" } } }
    },
    "person": {
      "$description": "Okabe-Ito. Encre de l'initiale : #000, sauf person-5 : #fff. Variante -line : light-dark(color-mix(in srgb, var(--person-N) 65%, #000), var(--person-N)) pour curseurs et traits (≥ 3:1).",
      "1": { "$type": "color", "$value": "#e69f00", "$extensions": { "inkwell": { "css": "--person-1", "ink": "#000000" } } },
      "2": { "$type": "color", "$value": "#56b4e9", "$extensions": { "inkwell": { "css": "--person-2", "ink": "#000000" } } },
      "3": { "$type": "color", "$value": "#009e73", "$extensions": { "inkwell": { "css": "--person-3", "ink": "#000000" } } },
      "4": { "$type": "color", "$value": "#f0e442", "$extensions": { "inkwell": { "css": "--person-4", "ink": "#000000" } } },
      "5": { "$type": "color", "$value": "#0072b2", "$extensions": { "inkwell": { "css": "--person-5", "ink": "#ffffff" } } },
      "6": { "$type": "color", "$value": "#d55e00", "$extensions": { "inkwell": { "css": "--person-6", "ink": "#000000" } } },
      "7": { "$type": "color", "$value": "#cc79a7", "$extensions": { "inkwell": { "css": "--person-7", "ink": "#000000" } } },
      "8": { "$type": "color", "$value": "#999999", "$extensions": { "inkwell": { "css": "--person-8", "ink": "#000000" } } }
    }
  },
  "font": {
    "family": {
      "ui": { "$type": "fontFamily", "$value": ["Adwaita Sans", "Inter", "system-ui", "sans-serif"], "$extensions": { "inkwell": { "css": "--font-ui" } } },
      "mono": { "$type": "fontFamily", "$value": ["Adwaita Mono", "JetBrains Mono", "ui-monospace", "monospace"], "$extensions": { "inkwell": { "css": "--font-mono" } } },
      "serif": { "$type": "fontFamily", "$value": ["Source Serif 4", "Georgia", "serif"], "$extensions": { "inkwell": { "css": "--font-serif" } } }
    },
    "text": {
      "$description": "Échelle de spec.md §2.3 ; toutes nouvelles (status new). Valeur CSS `font` raccourcie.",
      "caption": { "$type": "typography", "$value": { "fontSize": "12px", "lineHeight": 1.33, "fontWeight": 400 }, "$extensions": { "inkwell": { "css": "--text-caption" } } },
      "small": { "$type": "typography", "$value": { "fontSize": "13px", "lineHeight": 1.4, "fontWeight": 400 }, "$extensions": { "inkwell": { "css": "--text-small" } } },
      "body": { "$type": "typography", "$value": { "fontSize": "14px", "lineHeight": 1.45, "fontWeight": 400 }, "$extensions": { "inkwell": { "css": "--text-body" } } },
