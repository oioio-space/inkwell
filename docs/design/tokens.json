    "1": { "$type": "dimension", "$value": "4px", "$extensions": { "inkwell": { "css": "--space-1", "status": "kept" } } },
    "1b": { "$type": "dimension", "$value": "6px", "$extensions": { "inkwell": { "css": "--space-1b", "status": "new" } } },
    "2": { "$type": "dimension", "$value": "8px", "$extensions": { "inkwell": { "css": "--space-2", "status": "kept" } } },
    "3": { "$type": "dimension", "$value": "12px", "$extensions": { "inkwell": { "css": "--space-3", "status": "kept" } } },
    "4": { "$type": "dimension", "$value": "18px", "$extensions": { "inkwell": { "css": "--space-4", "status": "kept" } } },
    "5": { "$type": "dimension", "$value": "24px", "$extensions": { "inkwell": { "css": "--space-5", "status": "new" } } },
