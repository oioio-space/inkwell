      "title-2": { "$type": "typography", "$value": { "fontSize": "19px", "lineHeight": 1.25, "fontWeight": 800 }, "$extensions": { "inkwell": { "css": "--text-title-2" } } },
      "title-1": { "$type": "typography", "$value": { "fontSize": "25px", "lineHeight": 1.2, "fontWeight": 800 }, "$extensions": { "inkwell": { "css": "--text-title-1" } } },
