    "button": { "$type": "dimension", "$value": "9px", "$extensions": { "inkwell": { "css": "--radius-button", "status": "kept" } } },
    "default": { "$type": "dimension", "$value": "12px", "$extensions": { "inkwell": { "css": "--radius", "status": "kept" } } },
    "window": { "$type": "dimension", "$value": "15px", "$description": "Dialogues et fenêtre.", "$extensions": { "inkwell": { "css": "--radius-window", "status": "kept" } } },
    "pill": { "$type": "dimension", "$value": "999px", "$extensions": { "inkwell": { "css": "--radius-pill", "status": "new" } } }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": "0 0 0 1px var(--card-shade), 0 1px 3px 1px var(--card-shade)", "$extensions": { "inkwell": { "css": "--shadow-card", "status": "kept" } } },
    "popover": { "$type": "shadow", "$value": "0 0 0 1px rgb(0 0 6 / 14%), 0 4px 16px rgb(0 0 6 / 18%)", "$extensions": { "inkwell": { "css": "--shadow-popover", "dark": "0 0 0 1px rgb(0 0 0 / 60%), 0 4px 16px rgb(0 0 0 / 45%)", "status": "kept" } } },
