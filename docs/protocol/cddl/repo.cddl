; Protocole inkwell 2.0.0-brouillon.6 — couche « dépôt » (spec.md §9).
; Messages automerge-repo 2.x (et deux extensions inkwell, §9.6) dans les trames
; REPO (0x05) et PRESENCE (0x06), et dans les flux LARGE. Notation : RFC 8610.
;
; Ce fichier et spec.md §9 disent la même chose ; en cas d'écart, c'est un défaut
; de la spécification. Ce que le CDDL n'exprime pas est dans spec.md §9.2 :
;  - profil de validité CBOR (§9.2.1) : un seul élément, longueurs définies,
;    aucune étiquette, aucun flottant, aucun entier négatif, entiers ≤ 2^53 − 1,
;    clés de map en texte et uniques, profondeur ≤ 8, ≤ 4096 éléments,
;    map ≤ 64 paires, tableau ≤ 256 éléments ; il s'applique AUSSI aux champs
;    inconnus et au CBOR imbriqué de « data » des éphémères ;
;  - liaison au contexte : senderId = PeerID authentifié de l'émetteur,
;    targetId = PeerID du receveur, documentId ∈ ensemble admis (§9.4) ;
;  - maps OUVERTES (« * tstr => any ») : les clés inconnues sont ignorées et
;    jamais conservées ni retransmises ; maps FERMÉES (sans cette ligne) :
;    une clé de plus fait refuser le message.

repo-message = handshake / doc-message / ephemeral

; ---- poignée de main (≤ 1024 octets encodés) ----
handshake = {
  type: "arrive" / "welcome",
  ids,
  ? peerMetadata: peer-metadata,   ; ignorée (tout pair est éphémère, ADR 0031)
  ? projectUrl: automerge-url,     ; extension inkwell : document racine
  * tstr => any
}
peer-metadata = { * tstr => any }

; ---- messages de document ----
doc-message = sync / request / doc-unavailable / history-request / history-page

sync            = { type: "sync",            doc-header, data: bstr, * tstr => any }
request         = { type: "request",         doc-header, data: bstr, * tstr => any }
doc-unavailable = { type: "doc-unavailable", doc-header,             * tstr => any }

; Pages d'historique (§9.6, ADR 0031 M5) : demandées par le receveur.
history-request = {
  type: "history-request", doc-header,
  have: [0*256 change-hash],    ; têtes du demandeur ; la réponse contient TOUTE modification
                                ; hors de leur passé causal (branches concurrentes comprises)
  max: 65536..4194304,          ; taille maximale d'une page acceptée, enveloppe comprise (≤ part fixe, 4 Mio)
  * tstr => any
}
history-page = {
  type: "history-page", doc-header,
  changes: [0*256 bstr .size (1..16777216)],   ; modifications entières, ordre topologique
  last: bool,      ; true : plus rien après cette page ; une page vide DOIT avoir last = true
                   ; (réponse terminale « rien à envoyer »)
  * tstr => any
}

ids = (
  senderId: peer-id,     ; = PeerID authentifié de l'émetteur
  targetId: peer-id,     ; = PeerID du receveur (obligatoire dans TOUS les messages)
)
doc-header = (
  ids,
  documentId: document-id,   ; ∈ ensemble admis du receveur
)

; ---- éphémère : présence et présentation (trame PRESENCE, ≤ 2048 octets) ----
ephemeral = {
  type: "ephemeral",
  doc-header,
  sessionId: tstr .regexp "[0-9a-z]{1,16}",
  count: uint53 .ge 1,
  data: bstr .size (0..1024) .cbor ephemeral-payload,
  * tstr => any
}

ephemeral-payload = presence-envelope / present-envelope
presence-envelope = { "__presence": presence }     ; fermée
present-envelope  = { "__present": present }       ; fermée

presence  = heartbeat / goodbye / update / snapshot
heartbeat = { type: "heartbeat", * tstr => any }
goodbye   = { type: "goodbye",   * tstr => any }
update    = { type: "update", channel-pair, * tstr => any }
snapshot  = { type: "snapshot", state: snapshot-state, * tstr => any }
snapshot-state = { ? name: name-value, ? anchor: pos-value, ? head: pos-value }   ; fermée
channel-pair = ( channel: "name", value: name-value ) //
               ( channel: "anchor" / "head", value: pos-value )
name-value = tstr .size (0..128)
pos-value  = tstr .size (0..64)

; Pilotage de présentation : maps FERMÉES. Aucun flottant : le pointeur est en
; dix-millièmes de la diapositive (0 = bord gauche/haut, 10000 = bord droit/bas).
present = present-state / present-laser / present-laser-off / present-take
        / present-end / present-hello / present-ask / present-give / present-deny
present-state     = { t: "state", epoch: epoch, seq: uint53, slide: 1..100000,
                      step: 0..100000, screen: "show" / "black" / "white" }
present-laser     = { t: "laser", epoch: epoch, x: coord, y: coord }
present-laser-off = { t: "laser", epoch: epoch, x: null, y: null }
present-take      = { t: "take", epoch: epoch }
present-end       = { t: "end", epoch: epoch }
present-hello     = { t: "hello" }
present-ask       = { t: "ask" }
present-give      = { t: "give", to: peer-id, epoch: epoch }
present-deny      = { t: "deny", to: peer-id }
epoch = 0..2147483648
coord = 0..10000

; ---- types de base ----
uint53 = 0..9007199254740991                               ; entier exact en JavaScript
peer-id = tstr .regexp "[!-~]{1,64}"                        ; PeerID canonique (§3.1)
document-id = tstr .regexp "[1-9A-HJ-NP-Za-km-z]{1,64}"     ; bs58check de 16 octets (§9.4)
automerge-url = tstr .regexp "automerge:[1-9A-HJ-NP-Za-km-z]{1,70}"   ; ≤ 80 caractères
change-hash = bstr .size 32
