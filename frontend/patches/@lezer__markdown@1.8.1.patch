         let start = cx.absoluteLineStart, end = start, blockI = cx.block.children.length;
-        // Don't reuse anonymous nodes bigger than ¼ of the current
-        // block's size, to avoid creating lopsided trees.
-        let maxAnonSize = (cx.lineStart - cx.block.from) >> 2;
         let prevEnd = end, prevI = blockI;
         scan: for (;;) {
+            // Don't reuse anonymous nodes bigger than ¼ of the current block's size so
+            // far, to avoid creating lopsided trees. Measured at each node: computed once
