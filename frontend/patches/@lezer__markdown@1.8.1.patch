             if (cur.to - off > Math.min(fragEnd, cx.to) ||
-                cur.type.isAnonymous && cur.tree && (cur.to - cur.from > maxAnonSize || !canStopAfterLastChild(cur.tree))) {
+                cur.type.isAnonymous && cur.tree && (cur.to - cur.from > maxAnonSize || lastBlock(cur.tree) == 0 /* LastBlock.None */)) {
                 if (cur.type.isAnonymous && cur.firstChild())
                     continue;
                 break;
@@ -1945,9 +1955,13 @@ class FragmentCursor {
             // after an indented code block, since those can continue after
             // any number of blank lines.
             if (cur.type.isAnonymous || cur.type.is("Block")) {
-                // We checked earlier that anon nodes end in a block after
-                // which we can stop reuse.
-                if (cur.type.isAnonymous || NotLast.indexOf(cur.type.id) < 0) {
+                // We checked earlier that anon nodes end in a block. One that ends in a
+                // block reuse can't stop after (a list, indented code) is taken like that
+                // block: reuse may stop after it only once a following node is taken too.
+                // Refusing it instead split reuse into single blocks, which made every
+                // edit O(blocks) (Document balance, parseMixed walk).
+                if (cur.type.isAnonymous ? !cur.tree || lastBlock(cur.tree) == 2 /* LastBlock.CanStop */
+                    : NotLast.indexOf(cur.type.id) < 0) {
                     end = cur.to - off;
                     blockI = cx.block.children.length;
                 }
@@ -1972,15 +1986,17 @@ class FragmentCursor {
         return end - start;
     }
 }
-function canStopAfterLastChild(tree) {
+// What an anonymous node ends with: 0 = not a block (e.g. the quote mark of the next
+// line, or a buffer), 1 = a block reuse can't stop after (NotLast), 2 = a block it can.
+function lastBlock(tree) {
     while (tree.type.isAnonymous) {
         let last = tree.children[tree.children.length - 1];
         if (last instanceof common.Tree)
             tree = last;
         else
-            return false;
+            return 0;
     }
-    return tree.type.is("Block") && NotLast.indexOf(tree.type.id) < 0;
+    return !tree.type.is("Block") ? 0 : NotLast.indexOf(tree.type.id) < 0 ? 2 : 1;
 }
