{
  "id": "tables",
  "version": "1.0.0",
  "essential": true,
  "activation": ["onFileType:csv", "onFileType:tsv", "onFileType:psv"],
  "contributes": {
    "fileTypes": [
      {
        "id": "csv",
        "label": "kind.csv",
        "icon": "csv",
        "extensions": [".csv"],
        "mime": "text/csv",
        "storage": "text",
        "options": {
          "delimiter": ","
        }
      },
      {
        "id": "tsv",
        "label": "kind.csv",
        "icon": "csv",
        "extensions": [".tsv", ".tab"],
        "mime": "text/tab-separated-values",
        "storage": "text",
        "options": {
          "delimiter": "\t",
          "fixed": true,
          "quote": false
        }
      },
      {
        "id": "psv",
        "label": "kind.csv",
        "icon": "csv",
        "extensions": [".psv"],
        "storage": "text",
        "options": {
          "delimiter": "|",
          "fixed": true
        }
      }
    ],
    "viewers": [
      {
        "id": "tables.grid",
        "fileTypes": ["csv", "tsv", "psv"],
        "label": "sheet.showTable",
        "entry": "native/grid.ts",
        "capabilities": ["ui.native"],
        "commands": [
          "app.find",
          "app.replace",
          "app.find-next",
          "app.find-previous",
          "app.zoom-in",
          "app.zoom-out",
          "app.zoom-reset",
          "app.undo",
          "app.redo",
          "tables.fill-down",
          "tables.fill-right",
          "tables.insert-today",
          "tables.insert-cells",
          "tables.delete-cells",
          "tables.cut",
          "tables.copy",
          "tables.paste",
          "tables.paste-values",
          "tables.insert-row-above",
          "tables.insert-row-below",
          "tables.insert-col-left",
          "tables.insert-col-right",
          "tables.delete-rows",
          "tables.delete-cols",
          "tables.duplicate-row",
          "tables.clear",
          "tables.sort-asc",
          "tables.sort-desc",
          "tables.filter",
          "tables.filter-by-value",
          "tables.freeze",
          "tables.unfreeze",
          "tables.autofit"
        ],
        "ownStatus": true
      }
    ],
    "commands": [
      {
        "id": "tables.fill-down",
        "label": "cmd.fill-down",
        "category": "edit",
        "when": "!field",
        "unavailable": "cmd.tables.unavailable"
      },
      {
        "id": "tables.fill-right",
        "label": "cmd.fill-right",
        "category": "edit",
        "when": "!field",
        "unavailable": "cmd.tables.unavailable"
      },
      {
        "id": "tables.insert-today",
        "label": "cmd.insert-today",
        "category": "edit",
        "when": "!field",
        "unavailable": "cmd.tables.unavailable"
      },
      {
        "id": "tables.insert-cells",
        "label": "cmd.insert-cells",
        "category": "edit",
        "when": "!field",
        "unavailable": "cmd.tables.unavailable"
      },
      {
        "id": "tables.delete-cells",
        "label": "cmd.delete-cells",
        "category": "edit",
        "when": "!field",
        "unavailable": "cmd.tables.unavailable"
      },
      {
        "id": "tables.cut",
        "label": "sheet.cut",
        "icon": "copy",
        "category": "edit",
        "when": "!readOnly",
        "unavailable": "cmd.tables.readOnly"
      },
      {
        "id": "tables.copy",
        "label": "sheet.copy",
        "icon": "copy",
        "category": "edit",
        "unavailable": "cmd.tables.here"
      },
      {
        "id": "tables.paste",
        "label": "sheet.paste",
        "category": "edit",
        "when": "!readOnly",
        "unavailable": "cmd.tables.readOnly"
      },
      {
        "id": "tables.paste-values",
        "label": "sheet.pasteValues",
        "category": "edit",
        "when": "!readOnly",
        "unavailable": "cmd.tables.readOnly"
      },
      {
        "id": "tables.insert-row-above",
        "label": "sheet.insertRowAbove",
        "icon": "rowadd",
        "category": "edit",
        "when": "!readOnly && !gridLocked",
        "unavailable": "cmd.tables.structure"
      },
      {
        "id": "tables.insert-row-below",
        "label": "sheet.insertRowBelow",
        "icon": "rowadd",
        "category": "edit",
        "when": "!readOnly && !gridLocked",
        "unavailable": "cmd.tables.structure"
      },
      {
        "id": "tables.insert-col-left",
        "label": "sheet.insertColLeft",
        "icon": "coladd",
        "category": "edit",
        "when": "!readOnly",
        "unavailable": "cmd.tables.readOnly"
      },
      {
        "id": "tables.insert-col-right",
        "label": "sheet.insertColRight",
        "icon": "coladd",
        "category": "edit",
        "when": "!readOnly",
        "unavailable": "cmd.tables.readOnly"
      },
      {
        "id": "tables.delete-rows",
        "label": "sheet.deleteRows",
        "icon": "rowdel",
        "category": "edit",
        "when": "!readOnly",
        "unavailable": "cmd.tables.readOnly"
      },
      {
        "id": "tables.delete-cols",
        "label": "sheet.deleteCols",
        "icon": "coldel",
        "category": "edit",
        "when": "!readOnly",
        "unavailable": "cmd.tables.readOnly"
      },
      {
        "id": "tables.duplicate-row",
        "label": "sheet.duplicateRow",
        "category": "edit",
        "when": "!readOnly && !gridLocked",
        "unavailable": "cmd.tables.structure"
      },
      {
        "id": "tables.clear",
        "label": "sheet.clear",
        "category": "edit",
        "when": "!readOnly",
        "unavailable": "cmd.tables.readOnly"
      },
      {
        "id": "tables.sort-asc",
        "label": "sheet.sortAsc",
        "icon": "sortasc",
        "category": "edit",
        "unavailable": "cmd.tables.here"
      },
      {
        "id": "tables.sort-desc",
        "label": "sheet.sortDesc",
        "icon": "sortdesc",
        "category": "edit",
        "unavailable": "cmd.tables.here"
      },
      {
        "id": "tables.filter",
        "label": "sheet.filter",
        "icon": "filter",
        "category": "edit",
        "toggled": "gridFiltered",
        "unavailable": "cmd.tables.here"
      },
      {
        "id": "tables.filter-by-value",
        "label": "sheet.filterByValue",
        "icon": "filter",
        "category": "edit",
        "unavailable": "cmd.tables.here"
      },
      {
        "id": "tables.freeze",
        "label": "sheet.freeze",
        "icon": "freeze",
        "category": "edit",
        "unavailable": "cmd.tables.here"
      },
      {
        "id": "tables.unfreeze",
        "label": "sheet.unfreeze",
        "icon": "freeze",
        "category": "edit",
        "when": "gridFrozen",
        "unavailable": "cmd.tables.unfrozen",
        "toggled": "gridFrozen"
      },
      {
        "id": "tables.autofit",
        "label": "sheet.autofit",
        "category": "edit",
        "unavailable": "cmd.tables.here"
      }
    ],
    "menus": [
      {
        "command": "tables.insert-row-above",
        "location": "grid/toolbar",
        "group": "structure",
        "order": 10
      },
      {
        "command": "tables.delete-rows",
        "location": "grid/toolbar",
        "group": "structure",
        "order": 20
      },
      {
        "command": "tables.insert-col-left",
        "location": "grid/toolbar",
        "group": "structure",
        "order": 30
      },
      {
        "command": "tables.delete-cols",
        "location": "grid/toolbar",
        "group": "structure",
        "order": 40
      },
      {
        "command": "tables.sort-asc",
        "location": "grid/toolbar",
        "group": "sort",
        "order": 10
      },
      {
        "command": "tables.sort-desc",
        "location": "grid/toolbar",
        "group": "sort",
        "order": 20
      },
      {
        "command": "tables.filter",
        "location": "grid/toolbar",
        "group": "sort",
        "order": 30
      },
      {
        "command": "tables.freeze",
        "location": "grid/toolbar",
        "group": "freeze",
        "order": 10,
        "when": "!gridFrozen"
      },
      {
        "command": "tables.unfreeze",
        "location": "grid/toolbar",
        "group": "freeze",
        "order": 20,
        "when": "gridFrozen"
      },
      {
        "command": "tables.cut",
        "location": "grid/context",
        "group": "clipboard",
        "order": 10,
        "when": "!readOnly"
      },
      {
        "command": "tables.copy",
        "location": "grid/context",
        "group": "clipboard",
        "order": 20
      },
      {
        "command": "tables.paste",
        "location": "grid/context",
        "group": "clipboard",
        "order": 30,
        "when": "!readOnly"
      },
      {
        "command": "tables.paste-values",
        "location": "grid/context",
        "group": "clipboard",
        "order": 40,
        "when": "!readOnly"
      },
      {
        "command": "tables.insert-row-above",
        "location": "grid/context",
        "group": "structure",
        "order": 10,
        "when": "!readOnly"
      },
      {
        "command": "tables.insert-row-below",
        "location": "grid/context",
        "group": "structure",
        "order": 20,
        "when": "!readOnly"
      },
      {
        "command": "tables.insert-col-left",
        "location": "grid/context",
        "group": "structure",
        "order": 30,
        "when": "!readOnly"
      },
      {
        "command": "tables.insert-col-right",
        "location": "grid/context",
        "group": "structure",
        "order": 40,
        "when": "!readOnly"
      },
      {
        "command": "tables.delete-rows",
        "location": "grid/context",
        "group": "structure",
        "order": 50,
        "when": "!readOnly"
      },
      {
        "command": "tables.delete-cols",
        "location": "grid/context",
        "group": "structure",
        "order": 60,
        "when": "!readOnly"
      },
      {
        "command": "tables.duplicate-row",
        "location": "grid/context",
        "group": "structure",
        "order": 70,
        "when": "!readOnly"
      },
      {
        "command": "tables.clear",
        "location": "grid/context",
        "group": "structure",
        "order": 80,
        "when": "!readOnly"
      },
      {
        "command": "tables.sort-asc",
        "location": "grid/context",
        "group": "sort",
        "order": 10
      },
      {
        "command": "tables.sort-desc",
        "location": "grid/context",
        "group": "sort",
        "order": 20
      },
      {
        "command": "tables.filter-by-value",
        "location": "grid/context",
        "group": "sort",
        "order": 30
      },
      {
        "command": "tables.freeze",
        "location": "grid/context",
        "group": "freeze",
        "order": 10
      },
      {
        "command": "tables.unfreeze",
        "location": "grid/context",
        "group": "freeze",
        "order": 20,
        "when": "gridFrozen"
      },
      {
        "command": "tables.autofit",
        "location": "grid/context",
        "group": "freeze",
        "order": 30
      }
    ],
    "keybindings": [
      {
        "command": "tables.fill-down",
        "linux": ["Ctrl+d"],
        "mac": ["Meta+d"],
        "win": ["Ctrl+d"],
        "scope": "grid"
      },
      {
        "command": "tables.fill-right",
        "linux": ["Ctrl+r"],
        "mac": ["Meta+r"],
        "win": ["Ctrl+r"],
        "scope": "grid"
      },
      {
        "command": "tables.insert-today",
        "linux": ["Ctrl+;"],
        "mac": ["Meta+;"],
        "win": ["Ctrl+;"],
        "scope": "grid"
      },
      {
        "command": "tables.insert-cells",
        "linux": ["Ctrl++"],
        "mac": ["Meta++"],
        "win": ["Ctrl++"],
        "scope": "grid",
        "masks": ["app.zoom-in"]
      },
      {
        "command": "tables.delete-cells",
        "linux": ["Ctrl+-"],
        "mac": ["Meta+-"],
        "win": ["Ctrl+-"],
        "scope": "grid",
        "masks": ["app.zoom-out"]
      },
      {
        "command": "tables.cut",
        "linux": ["Ctrl+x"],
        "mac": ["Meta+x"],
        "win": ["Ctrl+x"],
        "scope": "grid",
        "delegated": "system"
      },
      {
        "command": "tables.copy",
        "linux": ["Ctrl+c"],
        "mac": ["Meta+c"],
        "win": ["Ctrl+c"],
        "scope": "grid",
        "delegated": "system"
      },
      {
        "command": "tables.paste",
        "linux": ["Ctrl+v"],
        "mac": ["Meta+v"],
        "win": ["Ctrl+v"],
        "scope": "grid",
        "delegated": "system"
      },
      {
        "command": "tables.paste-values",
        "linux": ["Ctrl+Shift+v"],
        "mac": ["Shift+Meta+v"],
        "win": ["Ctrl+Shift+v"],
        "scope": "grid",
        "delegated": "system"
      }
    ]
  }
}
