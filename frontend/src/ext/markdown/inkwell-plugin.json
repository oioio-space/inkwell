{
  "id": "markdown",
  "version": "1.0.0",
  "essential": true,
  "activation": ["onFileType:markdown", "onLanguage:markdown"],
  "contributes": {
    "fileTypes": [
      {
        "id": "markdown",
        "label": "kind.markdown",
        "icon": "markdown",
        "extensions": [".md", ".markdown"],
        "mime": "text/markdown",
        "storage": "text",
        "grammar": "markdown"
      }
    ],
    "grammars": [
      {
        "id": "markdown",
        "label": "lang.markdown",
        "names": ["md", "markdown"],
        "entry": "native/markdown.ts",
        "capabilities": ["ui.native"],
        "format": {
          "entry": "native/format.ts",
          "accepts": {
            "image": ["png", "jpeg", "gif", "webp", "svg", "bmp", "pdf"],
            "csvTable": ["csv", "tsv", "psv"]
          }
        }
      }
    ]
  }
}
