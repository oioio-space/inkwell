    "menus": [
      {
        "command": "format.bold",
        "location": "format",
        "group": "marks",
        "order": 10,
        "when": "bold in formats"
      },
      {
        "command": "format.italic",
        "location": "format",
        "group": "marks",
        "order": 20,
        "when": "italic in formats"
      },
      {
        "command": "format.underline",
        "location": "format",
        "group": "marks",
        "order": 30,
        "when": "underline in formats"
      },
      {
        "command": "format.strike",
        "location": "format",
        "group": "marks",
        "order": 40,
        "when": "strike in formats"
      },
      {
        "command": "format.link",
        "location": "format",
        "group": "inline",
        "order": 50,
        "when": "link in formats"
      },
      {
        "command": "format.code",
        "location": "format",
        "group": "inline",
        "order": 60,
        "when": "code in formats"
      },
      {
        "command": "format.codeblock",
        "location": "format",
        "group": "inline",
        "order": 70,
        "when": "codeblock in formats"
      },
      {
        "command": "format.formula",
        "location": "format",
        "group": "inline",
        "order": 80,
        "when": "formula in formats"
      },
      {
        "command": "format.ul",
        "location": "format",
        "group": "blocks",
        "order": 90,
        "when": "ul in formats"
      },
      {
        "command": "format.ol",
        "location": "format",
        "group": "blocks",
        "order": 100,
        "when": "ol in formats"
      },
      {
        "command": "format.task",
        "location": "format",
        "group": "blocks",
        "order": 110,
        "when": "task in formats"
      },
      {
        "command": "format.quote",
        "location": "format",
        "group": "blocks",
        "order": 120,
        "when": "quote in formats"
      },
      {
        "command": "format.table",
        "location": "format",
        "group": "objects",
        "order": 130,
        "when": "table in formats"
      },
      {
        "command": "format.paragraph",
        "location": "format/heading",
        "group": "paragraph",
        "order": 10
      },
      {
        "command": "format.h1",
        "location": "format/heading",
        "group": "headings",
        "order": 10,
        "when": "h1 in formats"
      },
      {
        "command": "format.h2",
        "location": "format/heading",
        "group": "headings",
        "order": 20,
        "when": "h2 in formats"
      },
      {
        "command": "format.h3",
        "location": "format/heading",
        "group": "headings",
        "order": 30,
        "when": "h3 in formats"
      },
      {
        "command": "format.h4",
        "location": "format/heading",
        "group": "headings",
        "order": 40,
        "when": "h4 in formats"
      }
    ],
    "keybindings": [
      {
        "command": "format.bold",
        "linux": ["Ctrl+b"],
        "mac": ["Meta+b"],
        "win": ["Ctrl+b"],
        "scope": "editor"
      },
      {
        "command": "format.italic",
        "linux": ["Ctrl+i"],
        "mac": ["Meta+i"],
        "win": ["Ctrl+i"],
        "scope": "editor",
        "masks": ["selectParentSyntax"]
      },
      {
        "command": "format.underline",
        "linux": ["Ctrl+u"],
        "mac": ["Meta+u"],
        "win": ["Ctrl+u"],
        "scope": "editor",
        "masks": ["undoSelection"]
      },
      {
        "command": "format.strike",
        "linux": ["Ctrl+Shift+x"],
        "mac": ["Shift+Meta+x"],
        "win": ["Ctrl+Shift+x"],
        "scope": "editor"
      },
      {
        "command": "format.code",
        "linux": ["Ctrl+e"],
        "mac": ["Ctrl+Meta+e"],
        "win": ["Ctrl+e"],
        "scope": "editor"
      },
      {
        "command": "format.codeblock",
        "linux": ["Ctrl+Shift+e"],
        "mac": ["Shift+Meta+e"],
        "win": ["Ctrl+Shift+e"],
        "scope": "editor"
      },
      {
        "command": "format.link",
        "linux": ["Ctrl+k"],
        "mac": ["Meta+k"],
        "win": ["Ctrl+k"],
        "scope": "editor"
      },
      {
        "command": "format.formula",
        "linux": ["Ctrl+m"],
        "mac": ["Shift+Meta+m"],
        "win": ["Ctrl+m"],
        "scope": "editor",
        "masks": ["toggleTabFocusMode"]
      },
      {
        "command": "format.h1",
        "linux": ["Ctrl+1"],
        "mac": ["Meta+1"],
        "win": ["Ctrl+1"],
        "scope": "editor"
      },
      {
        "command": "format.h2",
        "linux": ["Ctrl+2"],
        "mac": ["Meta+2"],
        "win": ["Ctrl+2"],
        "scope": "editor"
      },
      {
        "command": "format.h3",
        "linux": ["Ctrl+3"],
        "mac": ["Meta+3"],
        "win": ["Ctrl+3"],
        "scope": "editor"
      },
      {
        "command": "format.h4",
        "linux": ["Ctrl+4"],
        "mac": ["Meta+4"],
        "win": ["Ctrl+4"],
        "scope": "editor"
      }
