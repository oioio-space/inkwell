{
  "id": "text",
  "version": "1.0.0",
  "essential": true,
  "activation": ["startup"],
  "contributes": {
    "fileTypes": [
      {
        "id": "text",
        "label": "kind.text",
        "icon": "text",
        "extensions": [".txt"],
        "mime": "text/plain",
        "storage": "text"
      }
    ],
    "viewers": [
      {
        "id": "text.editor",
        "fileTypes": ["text"],
        "label": "sheet.showText",
        "entry": "native/editor.ts",
        "capabilities": ["ui.native"],
        "commands": [
          "app.undo",
          "app.redo",
          "format.bold",
          "format.italic",
          "format.underline",
          "format.strike",
          "format.link",
          "format.code",
          "format.codeblock",
          "format.formula",
          "format.ul",
          "format.ol",
          "format.task",
          "format.quote",
          "format.table",
          "format.h1",
          "format.h2",
          "format.h3",
          "format.h4",
          "format.paragraph",
          "format.insert-image",
          "format.insert-figure",
          "format.insert-include",
          "format.insert-attach",
          "format.insert-csv-table",
          "format.insert-data",
          "format.insert-bibliography",
          "format.insert-file-link",
          "format.insert-cite",
          "format.insert-ref",
          "format.insert-footnote",
          "format.insert-outline",
          "format.insert-pagebreak"
        ]
      }
    ]
  }
}
