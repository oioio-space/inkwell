{
  "id": "typst",
  "version": "1.0.0",
  "essential": true,
  "activation": ["startup"],
  "contributes": {
    "fileTypes": [
      {
        "id": "typst",
        "label": "kind.typst",
        "icon": "typst",
        "extensions": [".typ", ".typst"],
        "storage": "text",
        "grammar": "typst"
      }
    ],
    "grammars": [
      {
        "id": "typst",
        "names": ["typ", "typst"],
        "entry": "native/typst.ts",
        "capabilities": ["ui.native"]
      }
    ],
    "commands": [
      {
        "id": "typst.present",
        "label": "present.start",
        "category": "present",
        "when": "canPresent",
        "unavailable": "cmd.present.unavailable",
        "entry": "native/commands.ts",
        "capabilities": ["ui.native"],
        "icon": "present"
      },
      {
        "id": "typst.present-here",
        "label": "present.startHere",
        "category": "present",
        "when": "canPresent",
        "unavailable": "cmd.present.unavailable",
        "entry": "native/commands.ts",
        "capabilities": ["ui.native"]
      },
      {
        "id": "typst.present-public",
        "label": "present.showPublic",
        "category": "present",
        "when": "canPresent",
        "unavailable": "cmd.present.unavailable",
        "entry": "native/commands.ts",
        "capabilities": ["ui.native"]
      },
      {
        "id": "typst.export",
        "label": "menu.export",
        "category": "document",
        "entry": "native/commands.ts",
        "capabilities": ["ui.native"]
      },
      {
        "id": "typst.jump-to-preview",
        "label": "preview.jumpToCursor",
        "category": "navigate",
        "when": "fileType == typst",
        "unavailable": "cmd.typst.unavailable",
        "entry": "native/commands.ts",
        "capabilities": ["ui.native"],
        "icon": "target"
      },
      {
        "id": "typst.preview-zoom-out",
        "label": "preview.zoomOut",
        "icon": "minus",
        "category": "view",
        "when": "main && previewOpen",
        "unavailable": "cmd.previewClosed.unavailable",
        "entry": "native/commands.ts",
        "capabilities": ["ui.native"]
      },
      {
        "id": "typst.preview-zoom-in",
        "label": "preview.zoomIn",
        "icon": "plus",
        "category": "view",
        "when": "main && previewOpen",
        "unavailable": "cmd.previewClosed.unavailable",
        "entry": "native/commands.ts",
        "capabilities": ["ui.native"]
      },
      {
        "id": "typst.preview-fit",
        "label": "preview.fitCommand",
        "category": "view",
        "when": "main && previewOpen",
        "unavailable": "cmd.previewClosed.unavailable",
        "entry": "native/commands.ts",
        "capabilities": ["ui.native"]
      },
      {
        "id": "typst.signature-help",
        "label": "cmd.signature-help",
        "category": "edit",
        "when": "focus == editor && fileType == typst",
        "unavailable": "cmd.typst.unavailable",
        "entry": "native/commands.ts",
        "capabilities": ["ui.native"]
      }
    ],
    "menus": [
      {
        "command": "typst.present",
        "location": "main",
        "group": "document",
        "order": 10
      },
      {
        "command": "typst.present-here",
        "location": "main",
        "group": "document",
        "order": 20
      },
      {
        "command": "typst.present-public",
        "location": "main",
        "group": "document",
        "order": 30
      },
      {
        "command": "typst.export",
        "location": "main",
        "group": "document",
        "order": 40
      },
      {
        "command": "typst.present",
        "location": "header/end",
        "group": "view",
        "order": 20,
        "when": "canPresent && fileType == typst"
      },
      {
        "command": "typst.preview-zoom-out",
        "location": "preview/toolbar",
        "group": "zoom-out",
        "order": 10
      },
      {
        "command": "typst.preview-zoom-in",
        "location": "preview/toolbar",
        "group": "zoom-in",
        "order": 10
      },
      {
        "command": "typst.jump-to-preview",
        "location": "preview/toolbar",
        "group": "navigate",
        "order": 10
      }
    ],
    "status": [
      {
        "id": "typst.problems",
        "label": "problems.label",
        "side": "end",
        "group": "problems",
        "order": 10,
        "when": "fileType == typst",
        "command": "app.problem-next",
        "entry": "native/status.ts",
        "capabilities": ["ui.native"]
      },
      {
        "id": "typst.page",
        "label": "status.item.page",
        "side": "end",
        "group": "preview",
        "order": 10,
        "when": "main && previewOpen",
        "entry": "native/status.ts",
        "capabilities": ["ui.native"]
      }
    ],
    "keybindings": [
      {
        "command": "typst.present",
        "linux": ["F5"],
        "mac": ["Alt+Meta+p"],
        "win": ["F5"],
        "scope": "window"
      },
      {
        "command": "typst.present-here",
        "linux": ["Shift+F5"],
        "mac": ["Alt+Shift+Meta+p"],
        "win": ["Shift+F5"],
        "scope": "window"
      },
      {
        "command": "typst.jump-to-preview",
        "linux": ["Ctrl+Shift+j"],
        "mac": ["Shift+Meta+j"],
        "win": ["Ctrl+Shift+j"],
        "scope": "window"
      },
      {
        "command": "typst.signature-help",
        "linux": ["Ctrl+Shift+Space"],
        "mac": ["Shift+Meta+Space"],
        "win": ["Ctrl+Shift+Space"],
        "scope": "editor"
      }
    ]
  }
}
