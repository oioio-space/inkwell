{
  "name": "inkwell-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MPL-2.0",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --configLoader runner --minify false --mode development && node scripts/keep-dist.mjs",
    "build": "vite build --configLoader runner --mode production && node scripts/keep-dist.mjs",
    "check": "biome check . && svelte-check --tsconfig ./tsconfig.json && vitest run --configLoader runner",
    "fmt": "biome check --write .",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest",
    "vectors:repo": "NODE_PATH=./node_modules node ../protocol/cmd/repo-vectors/main.cjs"
  },
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "@automerge/automerge-codemirror": "0.2.0",
    "@automerge/automerge-repo": "2.5.6",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@wailsio/runtime": "3.0.0",
    "cbor-x": "1.6.8",
    "codemirror": "6.0.2",
    "codemirror-lang-typst": "0.6.0",
    "papaparse": "5.7.0",
    "@inkwell/protocol": "workspace:*",
    "@codemirror/autocomplete": "6.20.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/papaparse": "5.5.2",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
