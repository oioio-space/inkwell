<?xml version="1.0" encoding="UTF-8"?>
<!-- The file types Inkwell opens that shared-mime-info lacks (plan
     docs/plans/2026-11-11-oi-single-instance-open.md, section 4.5). Typst documents: recent
     shared-mime-info versions already know text/x-typst; this definition makes the file type exist
     on the older ones, and is harmless on the others. Separated values: shared-mime-info maps
     *.tsv to text/tab-separated-values but not *.tab, and has no type for pipe-separated values
     (*.psv), defined here as text/x-psv. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-typst">
    <comment>Typst document</comment>
    <comment xml:lang="fr">Document Typst</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.typ"/>
  </mime-type>
  <mime-type type="text/tab-separated-values">
    <glob pattern="*.tab"/>
  </mime-type>
  <mime-type type="text/x-psv">
    <comment>Pipe-separated values</comment>
    <comment xml:lang="fr">Valeurs séparées par des barres verticales</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.psv"/>
  </mime-type>
</mime-info>
