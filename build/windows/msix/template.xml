<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="inkwell"
        Arguments=""
        InstallLocation="C:\Program Files\oioio-space\Inkwell">
    </Installer>
    <PackageInformation
        PackageName="Inkwell"
        PackageDisplayName="Inkwell"
        PublisherName="CN=oioio-space"
        PublisherDisplayName="oioio-space"
        Version="0.1.0.0"
        PackageDescription="Éditeur collaboratif Typst">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="space.oioio.inkwell"
                Description="Éditeur collaboratif Typst"
                DisplayName="Inkwell"
                ExecutableName="inkwell"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Inkwell</DisplayName>
            <PublisherDisplayName>oioio-space</PublisherDisplayName>
            <Description>Éditeur collaboratif Typst</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="inkwell.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
