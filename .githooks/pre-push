#!/usr/bin/env bash
# Git native pre-push hook — run the CI gate before sharing code.
# Installed via core.hooksPath=.githooks. Keeps per-commit hooks fast (staged-only)
# while making `git push` thorough: secrets + vulns + SBOM/grype + lints + tests (`mise run ci:core`),
# then the impaired-network simulation only when the pushed diff touches its inputs
# (scripts/netsim/affected.py; GitHub always runs it in full, in its own job).
#
# Bypass in an emergency only: git push --no-verify
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
# Git exports repository-local variables (GIT_DIR, GIT_INDEX_FILE, …) to hooks; tests that create their own
# temporary repositories would then act on this one. Clear them, as git's own documentation advises
# (`git rev-parse --local-env-vars`).
cd "$repo_root"
unset $(git rev-parse --local-env-vars)

if command -v mise >/dev/null 2>&1 && [[ -f "$repo_root/mise.toml" ]]; then
  # Decide first (seconds): a run keeps the netsim in parallel with the other checks (`mise run ci`),
  # a skip runs everything else (`mise run ci:core`).
  # Exit 0 = run, 10 = skip; anything else (crash, python missing) runs: fail towards running.
  selector=0
  python3 -I "$repo_root/scripts/netsim/affected.py" --pre-push || selector=$?
  task=ci
  [[ $selector -eq 10 ]] && task=ci:core
  printf '\033[34m▶ Pre-push: running CI (mise run %s)…\033[0m\n' "$task"
  if ! mise run "$task"; then
    printf '\033[31m✗ Push blocked: CI failed. Fix the issues above (or git push --no-verify).\033[0m\n' >&2
    exit 1
  fi
else
  printf '\033[33m⚠ mise not found — skipping pre-push CI.\033[0m\n' >&2
fi
