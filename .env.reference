# Inventory of every environment variable inkwell's code reads (product, tooling, tests).
# Not loaded by anything: Vite and mise only read `.env` / `.env.<mode>`; this file documents
# the configuration surface and declares each variable's provider for contract checks (gortex).
# Kept exhaustive by scripts/check-env-reference.py (`mise run lint:env`, part of `mise run ci`): a variable read in
# code but missing here fails the lint. Values are left empty on purpose: never put a secret here.

# ── Product, set by the person or the packaging ────────────────────────────────────────────────
# Data directory for identities and projects (tests point it at a temporary directory).
INKWELL_HOME=
# Port of the Wails server build (`-tags server`, e2e only).
INKWELL_SERVER_PORT=

# ── Operating system and desktop (read, never set by inkwell) ──────────────────────────────────
HOME=
USERPROFILE=
APPDATA=
LOCALAPPDATA=
LANG=
LC_ALL=
LC_CTYPE=
XDG_CACHE_HOME=
XDG_CONFIG_HOME=
XDG_CONFIG_DIRS=
XDG_DATA_HOME=
XDG_DATA_DIRS=
XDG_STATE_HOME=
XDG_RUNTIME_DIR=
XDG_DOCUMENTS_DIR=
# GTK backend for the native perf build (x11 for the input driver's target check).
GDK_BACKEND=

# ── Build and tooling (mise tasks, Vite, CI) ──────────────────────────────────────────────────
# Set by CI runners; switches Playwright to WebKit and stricter retries.
CI=
# Vite: dev-server port given by Wails; MODE and VITEST are Vite/Vitest built-ins.
WAILS_VITE_PORT=
MODE=
VITEST=
# Vite build flags (mise e2e:build, perf builds).
VITE_E2E_OBSERVE=
VITE_PERF_NATIVE=
VITE_PERF_CM_TYPING=
# Gates and perf scripts.
INKWELL_GATE_ROOT=
INKWELL_GATE_RUNNER=
INKWELL_PERF=
INKWELL_PERF_OUT=
INKWELL_BASELINE_SELF_TEST=
PERF_SLOW=
# Protocol conformance stage (ADR 0034 migration step).
INKWELL_PROTOCOL_STEP=
# Cache override for pinned tooling jars (TLA+ and Alloy).
INKWELL_TLA_CACHE=
INKWELL_ALLOY_CACHE=
# Per-test-binary address-space cap of scripts/memcap.sh (mutation testing; default 6 GB, done and
# mutate:go use 1.8 GB so 4 workers stay under the 8 GB of heavy.sh).
INKWELL_AS_LIMIT=

# ── End-to-end and network simulation (mise e2e*, Playwright) ──────────────────────────────────
INKWELL_E2E_BROWSER=
INKWELL_E2E_DOCS=
INKWELL_E2E_PORT=
INKWELL_E2E_WS=
NETSIM_BIN_DIR=
NETSIM_EXPECT=
NETSIM_MUTANT_SEED=
NETSIM_OUT=
NETSIM_RUN=
NETSIM_SCENARIO=
NETSIM_SCENARIOS=
NETSIM_SEED=
NETSIM_SEEDS=
NETSIM_TOPOLOGY=
NETSIM_VARIANT=
NETSIM_VARIANTS=

# ── Native typing bench (perf_native build, scripts/perf/type-native.sh) ───────────────────────
INKWELL_NATIVE_PERF_RUN=
INKWELL_NATIVE_PERF_RUN_ID=
INKWELL_NATIVE_PERF_PHASE=
INKWELL_NATIVE_PERF_OUT=
INKWELL_NATIVE_PERF_TARGET=

# ── Test harness: set by a parent test for the child process it re-executes (sidecar sandbox) ─
INKWELL_ATTACK=
INKWELL_BUS=
INKWELL_EXEC_DENIED=
INKWELL_MOUNT_DIR=
INKWELL_MOUNT_ERRORS=
INKWELL_MOUNT_UNIT=
INKWELL_PRIVATE_PID=
INKWELL_REPORT_HOST_PID=
INKWELL_RUNTIME=
INKWELL_SENTINEL=
INKWELL_SHMID=
INKWELL_SIBLING=
INKWELL_WATCHDOG_HANG=
INKWELL_X11=
