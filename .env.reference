# Inventory of every environment variable inkwell's code reads (product, tooling, tests).
# Not loaded by anything: Vite and mise only read `.env` / `.env.<mode>`; this file documents
# the configuration surface.
# Kept exhaustive by scripts/check-env-reference.py (`mise run lint:env`, part of `mise run ci`): a variable read in
# code but missing here fails the lint. Values are left empty on purpose: never put a secret here.

# ── Product, set by the person or the packaging ────────────────────────────────────────────────
# Data directory for identities and projects (tests point it at a temporary directory).
INKWELL_HOME=
INKWELL_DOCS=
# Port of the Wails server build (`-tags server`, e2e only).
INKWELL_SERVER_PORT=
# Set to 1 by Inkwell itself in the image a project change restarts; read once and removed.
INKWELL_AFTER_TAKEOVER=

# ── Operating system and desktop (read, never set by inkwell) ──────────────────────────────────
HOME=
USERPROFILE=
APPDATA=
LOCALAPPDATA=
LANG=
LC_ALL=
LC_CTYPE=
# Language of the notifications of a launch that has no window (R11, R17, R18 of block OI).
LC_MESSAGES=
# Activation token of a launch, forwarded to the running window so that it may come to the
# front (block OI; xdg-activation, then the older startup notification).
XDG_ACTIVATION_TOKEN=
DESKTOP_STARTUP_ID=
XDG_CACHE_HOME=
XDG_CONFIG_HOME=
XDG_CONFIG_DIRS=
XDG_DATA_HOME=
XDG_DATA_DIRS=
XDG_STATE_HOME=
XDG_RUNTIME_DIR=
XDG_DOCUMENTS_DIR=
# GTK backend for the native perf build (x11 for the input driver's target check).
GDK_BACKEND=

# ── Build and tooling (mise tasks, Vite, CI) ──────────────────────────────────────────────────
# Set by CI runners; switches Playwright to WebKit and stricter retries.
CI=
# Vite: dev-server port given by Wails; MODE and VITEST are Vite/Vitest built-ins.
WAILS_VITE_PORT=
MODE=
VITEST=
# Vite build flags (mise e2e:build, perf builds).
VITE_E2E_OBSERVE=
VITE_PERF_NATIVE=
VITE_PERF_CM_TYPING=
# Gates and perf scripts.
INKWELL_GATE_ROOT=
INKWELL_GATE_RUNNER=
# Set by gate.py for each criterion: a gate started inside it is deferred, not run (method v2 rule 6).
INKWELL_GATE_PARENT=
INKWELL_GATE_PARENT_OUT=
INKWELL_PERF=
INKWELL_PERF_OUT=
INKWELL_BASELINE_SELF_TEST=
# Layout pads of block RG (docs/perf/2026-11-12-layout/genpad.py: the first pad design, an opaque init guard that
# is never set) and the model prototype's switch to the staged rule (rgsim.py).
INKWELL_LAYOUT_PAD_NEVER=
RG_STAGED=
# Netsim selector tests (scripts/netsim/affected_test.py): a file of `go list -json` output used instead of `go list`.
INKWELL_AFFECTED_GOLIST=
# Set by git in its hooks; the netsim selector tests clear it (scripts/netsim/affected_test.py, clean_env).
GIT_DIR=
# Seed of the sync-indicator model-based test (frontend/src/net/syncIndicator.model.test.ts), to replay a failure.
SI1_SEED=
# Directory where the OI walkthrough harness writes its captures (frontend/e2e/ux/oi.spec.ts).
UX_OI_SHOTS=
PERF_SLOW=
# Protocol conformance stage (ADR 0034 migration step).
INKWELL_PROTOCOL_STEP=
# Sandbox probe (scripts/sandbox-probe.sh, block SB2): 1 lets the measurement test of internal/sidecar
# run; INKWELL_PROBE_SUDO=1 also loads two test AppArmor profiles (GitHub runner only).
INKWELL_SANDBOX_PROBE=
# W58a interface walkthrough driver (frontend/e2e/ux/w58a.spec.ts): runs only when set; W58A_DARK=1 captures dark.
W58A_UX=
W58A_DARK=
INKWELL_PROBE_SUDO=
# 1 runs TestMemoryMaxBackstop of internal/sidecar (residual R-7): the kernel OOM-kills a target, desktop notification.
INKWELL_OOM_BACKSTOP=
# Cache override for pinned tooling jars (TLA+ and Alloy).
INKWELL_TLA_CACHE=
# scripts/tla-check.sh inner loop: run only the TLC runs whose name matches this regex (unset: all).
INKWELL_TLA_ONLY=
# scripts/tla-check.sh GitHub CI partition (1/3, 2/3, 3/3; unset: all).
TLA_SHARD=
INKWELL_ALLOY_CACHE=
# Per-test-binary address-space cap of scripts/memcap.sh (mutation testing; default 6 GB, done and
# mutate:go use 1.8 GB so 4 workers stay under the 8 GB of heavy.sh).
INKWELL_AS_LIMIT=
# glibc malloc arenas under that cap (scripts/memcap.sh sets 2 unless given): one 64 MB arena per
# thread would exhaust the address space of a cgo test binary.
MALLOC_ARENA_MAX=

# ── End-to-end and network simulation (mise e2e*, Playwright) ──────────────────────────────────
INKWELL_E2E_BROWSER=
INKWELL_E2E_DOCS=
INKWELL_E2E_PROFILE=
WC1_NATIVE_CHILD=
WC1_NATIVE_MODE=
WC1_NATIVE_OUT=
WC1_NATIVE_PROOF=
WC1_NATIVE_REQUEST=
WC1_NATIVE_SCENARIO=
INKWELL_E2E_PORT=
INKWELL_E2E_WS=
NETSIM_BIN_DIR=
NETSIM_EXPECT=
NETSIM_MUTANT_SEED=
NETSIM_OUT=
NETSIM_REPEAT=
NETSIM_RUN=
NETSIM_SCENARIO=
NETSIM_SCENARIOS=
NETSIM_SEED=
NETSIM_SEEDS=
NETSIM_TOPOLOGY=
NETSIM_VARIANT=
NETSIM_VARIANTS=

# ── Native typing bench (perf_native build, scripts/perf/type-native.sh) ───────────────────────
INKWELL_NATIVE_PERF_RUN=
INKWELL_NATIVE_PERF_RUN_ID=
INKWELL_NATIVE_PERF_PHASE=
INKWELL_NATIVE_PERF_OUT=
INKWELL_NATIVE_PERF_TARGET=

# ── Test harness: set by a parent test for the child process it re-executes (sidecar sandbox) ─
INKWELL_ATTACK=
INKWELL_BUS=
INKWELL_EXEC_DENIED=
# Child-process switches of the sidecar death-rule tests (internal/sidecar/death_rules_linux_test.go, gate SB1b J1).
INKWELL_INIT_REPORT=
INKWELL_PARENT_DEATH=
INKWELL_MOUNT_DIR=
INKWELL_MOUNT_ERRORS=
INKWELL_MOUNT_UNIT=
INKWELL_PRIVATE_PID=
INKWELL_REPORT_HOST_PID=
INKWELL_RUNTIME=
# Manifest of the hostile tests' deliberate sandbox deaths, set by scripts/sandbox_no_coredump.py (gate SB1b, row J1).
INKWELL_SANDBOX_DEATHS=
INKWELL_SENTINEL=
INKWELL_SHMID=
INKWELL_SIBLING=
# Address space the race runtime reserves, handed to the scope-app test helper so that its target reaches the cgroup bound before RLIMIT_AS (internal/sidecar bound tests).
INKWELL_TEST_ADDRESS_RESERVE=
# Project directory handed to the scope-app test helper process (internal/sidecar scope tests, gate SB1b).
INKWELL_TEST_PROJECT=
INKWELL_WATCHDOG_HANG=
INKWELL_X11=
# Single instance (block OI): the helper launches of internal/instance and cmd/inkwell tests.
INKWELL_INSTANCE_CHILD=
INKWELL_CMD_CHILD=
INKWELL_CHILD_DIR=
INKWELL_CHILD_ARG=
INKWELL_CHILD_ARGS=
INKWELL_CHILD_TICKET=
INKWELL_CHILD_DEADLINE=

# ── Free model providers (scripts/llm.sh, scripts/quotas.sh; keys live in mise.local.toml only) ──
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
LLM_PROVIDERS=
LLM_FREE_MODEL=
LLM_OPENROUTER_FREE_MODEL=
LLM_MECHANICAL_MODEL=
LLM_WRITING_MODEL=
LLM_MAX_INPUT_BYTES=
LLM_GROQ_MAX_INPUT_BYTES=
LLM_CF_MAX_INPUT_BYTES=
LLM_API_ROOT_GROQ=
LLM_API_ROOT_CLOUDFLARE=
LLM_API_ROOT_OPENROUTER=
QUOTAS_FILE=
GEMINI_MODEL=
