# Build / release
/dist/
# Root-anchored so it ignores only a top-level `go build` artifact, not cmd/inkwell/.
/inkwell
*.exe
*.test

# Test & scan output (regenerable — see scripts/clean-artifacts.sh)
coverage.out
coverage.html
junit.xml
sbom.cdx.json
bench-*.txt
*.prof

# Local-only
.env
.env.*
mise.local.toml
.DS_Store

# IDE
.idea/

# Frontend & Wails (regenerable)
frontend/node_modules/
frontend/bindings/
frontend/dist/*
!frontend/dist/.gitkeep
bin/
.task/
build/linux/appimage/build/
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
build/linux/inkwell.desktop
frontend/test-results/
frontend/playwright-report/

# Sidecar binaries are fetched at build time (mise run sidecar:fetch), never committed;
# only the .gitkeep placeholders that keep `go:embed` buildable are tracked.
!/internal/sidecar/bin/
/internal/sidecar/bin/*/*
!/internal/sidecar/bin/*/.gitkeep

# Agent worktrees (Claude Code)
.claude/worktrees/
