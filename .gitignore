# Build / release
/dist/
# Root-anchored so it ignores only a top-level `go build` artifact, not cmd/inkwell/.
/inkwell
*.exe
*.test

# Test & scan output (regenerable — see scripts/clean-artifacts.sh)
coverage.out
coverage.protocol.out
coverage.html
junit.xml
sbom.cdx.json
bench-*.txt
*.prof

# TLC trace files (regenerable model-checking artifacts)
docs/protocol/tla/*_TTrace_*
docs/protocol/tla/mutants/*_TTrace_*

# Local-only
.env
.env.*
# Inventory of env var names only; scripts/check-env-reference.py refuses any value in it.
!.env.reference
mise.local.toml
.DS_Store

# IDE
.idea/

# Frontend & Wails (regenerable)
frontend/**/node_modules/
frontend/bindings/
frontend/dist/
bin/
.task/
build/linux/appimage/build/
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
build/linux/inkwell.desktop
frontend/test-results/
frontend/playwright-report/

# Sidecar binaries are fetched at build time (mise run sidecar:fetch), never committed;
# only the .gitkeep placeholders that keep `go:embed` buildable are tracked.
!/internal/sidecar/bin/
/internal/sidecar/bin/*/*
!/internal/sidecar/bin/*/.gitkeep

# Agent worktrees (Claude Code)
.claude/worktrees/
/.playwright-mcp/

# Gate execution logs are regenerable and stay ignored; the gate (gates/<bloc>.toml, .json) and its
# reports (SIMPLIFY.md, SUMMARY*.md, REVIEW*.md, UX-walkthrough.md) are evidence and are versioned.
/gates/*/*
!/gates/*/*.md
__pycache__/
/testdata/perf/generated/

# Dedicated native performance assets; never embedded by a normal build.
/frontend/perf-dist/

# pnpm content-addressable store (created by pnpm in the worktree; 248 MB).
/.pnpm-store/
